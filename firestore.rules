rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isNumber(val) {
      return val is int || val is float;
    }

    function getGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupMember(groupId) {
      return isSignedIn() && (
        request.auth.uid == getGroup(groupId).createdBy ||
        (request.auth.uid in getGroup(groupId).memberUids) ||
        (request.auth.token.email != null && getGroup(groupId).get('memberEmails', []) is list && request.auth.token.email in getGroup(groupId).get('memberEmails', []))
      );
    }

    function isGroupEditor(groupId) {
      return isSignedIn() && (
        request.auth.uid == getGroup(groupId).createdBy ||
        (
          (
            (request.auth.uid in getGroup(groupId).memberUids) ||
            (request.auth.token.email != null && getGroup(groupId).get('memberEmails', []) is list && request.auth.token.email in getGroup(groupId).get('memberEmails', []))
          ) &&
          (
            getGroup(groupId).get('members', {}).get(request.auth.uid, {}).get('role', 'editor') != 'viewer'
          )
        )
      );
    }

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 256;
    }

    function isValidExpense(data, groupId) {
      return (
        (data.get('name', '') is string && data.get('name', '').size() > 0 && data.get('name', '').size() <= 150) ||
        (data.get('title', '') is string && data.get('title', '').size() > 0 && data.get('title', '').size() <= 150)
      ) &&
      isNumber(data.amount) && data.amount >= 0 &&
      data.category is string && data.category.size() <= 50 &&
      data.date is string && data.date.size() <= 32 &&
      data.groupId == groupId;
    }

    function isValidShoppingItem(data, groupId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.groupId == groupId &&
        (
          data.get('status', 'pending') in ['pending', 'bought'] ||
          data.get('bought', false) is bool
        );
    }

    function isValidRecurring(data, groupId) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        isNumber(data.amount) && data.amount >= 0 &&
        data.category is string && data.category.size() <= 50 &&
        data.frequency is string && data.frequency.size() <= 32 &&
        data.groupId == groupId;
    }

    function isValidNotification(data, groupId) {
      return data.groupId == groupId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
        data.message is string && data.message.size() <= 500;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Groups
    match /groups/{groupId} {
      allow get: if isSignedIn() && (
        resource == null ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (request.auth.token.email != null && resource.data.get('memberEmails', []) is list && request.auth.token.email in resource.data.get('memberEmails', [])) ||
        resource.data.get('inviteCode', null) != null
      );
      
      allow list: if isSignedIn();

      allow create: if isSignedIn() && 
        isValidId(groupId) && 
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string && 
        request.resource.data.name.size() > 0 && 
        request.resource.data.name.size() <= 100 &&
        request.resource.data.memberUids is list &&
        request.auth.uid in request.resource.data.memberUids;
      
      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.memberUids ||
        (request.auth.token.email != null && resource.data.get('memberEmails', []) is list && request.auth.token.email in resource.data.get('memberEmails', [])) ||
        (request.auth.uid in request.resource.data.memberUids)
      ) &&
      (request.resource.data.createdBy == resource.data.createdBy);

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Subcollection: Expenses
      match /expenses/{expenseId} {
        allow read: if isGroupMember(groupId);
        allow create: if (isGroupEditor(groupId) || (isSignedIn() && request.resource.data.get('createdBy', '') == request.auth.uid)) && isValidId(expenseId) && isValidExpense(request.resource.data, groupId);
        allow update: if isGroupEditor(groupId) && isValidExpense(request.resource.data, groupId);
        allow delete: if isGroupEditor(groupId);
      }

      // Subcollection: Shopping list
      match /shopping/{itemId} {
        allow read: if isGroupMember(groupId);
        allow create: if (isGroupEditor(groupId) || (isSignedIn() && request.resource.data.get('createdBy', '') == request.auth.uid)) && isValidId(itemId) && isValidShoppingItem(request.resource.data, groupId);
        allow update: if isGroupEditor(groupId) && isValidShoppingItem(request.resource.data, groupId);
        allow delete: if isGroupEditor(groupId);
      }

      // Subcollection: Recurring expenses
      match /recurring/{recurringId} {
        allow read: if isGroupMember(groupId);
        allow create: if (isGroupEditor(groupId) || (isSignedIn() && request.resource.data.get('createdBy', '') == request.auth.uid)) && isValidId(recurringId) && isValidRecurring(request.resource.data, groupId);
        allow update: if isGroupEditor(groupId) && isValidRecurring(request.resource.data, groupId);
        allow delete: if isGroupEditor(groupId);
      }

      // Subcollection: Notifications
      match /notifications/{notificationId} {
        allow read, create, update, delete: if isGroupMember(groupId);
      }
    }
  }
}
